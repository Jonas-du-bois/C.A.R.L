# C.A.R.L. — variables d'environnement
# Copiez ce fichier vers .env et remplacez les valeurs d'exemple.

# --- Runtime ---
# Environnement d'exécution. Optionnelle, défaut: production dans Compose.
NODE_ENV=production
# Fuseau utilisé pour la saisie et l'affichage des dates. Optionnelle, défaut: Europe/Paris.
APP_TIMEZONE=Europe/Paris
# Port HTTP de /health. Optionnelle, défaut: 10000.
PORT=10000
# Niveau de logs Winston. Optionnelle, défaut: info.
LOG_LEVEL=info

# --- Base de données ---
# Chemin SQLite persistant. Obligatoire.
DATABASE_PATH=/app/data/carl.db

# --- Session WhatsApp ---
# Répertoire LocalAuth persistant. Optionnelle, défaut: ./data/.wwebjs_auth.
WHATSAPP_SESSION_PATH=/app/data/.wwebjs_auth

# --- IA ---
# Au moins une clé est obligatoire si ENABLE_AUTO_RESPONSE=true.
GEMINI_API_KEY=
# Modèle Gemini. Optionnelle, défaut: gemini-2.0-flash.
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
# Modèle Groq. Optionnelle, défaut: llama-3.1-70b-versatile.
GROQ_MODEL=llama-3.1-70b-versatile
OPENAI_API_KEY=
# Modèle OpenAI. Optionnelle, défaut: gpt-4o.
OPENAI_MODEL=gpt-4o
# Limite de sortie commune, entier strictement positif. Optionnelle, défaut: 500.
AI_MAX_TOKENS=500
# Température commune, entre 0 et 2. Optionnelle, défaut: 0.3.
AI_TEMPERATURE=0.3
# Anciens noms acceptés comme alias dépréciés:
# OPENAI_MAX_TOKENS=
# OPENAI_TEMPERATURE=

# --- Telegram ---
# Nécessaires si les rapports quotidiens ou les alertes sont activés.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
# Utilisateur autorisé. Optionnelle, défaut: TELEGRAM_ADMIN_ID.
TELEGRAM_ALLOWED_USER_ID=

# --- Google Calendar ---
# Intégration optionnelle. JSON du compte de service sur une seule ligne.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Calendrier cible. Optionnelle, défaut: primary.
GOOGLE_CALENDAR_ID=primary
# Ancien alias accepté avec avertissement de dépréciation:
# GOOGLE_SERVICE_ACCOUNT_KEY=

# --- Fonctionnalités ---
# Rapport quotidien. Optionnelle, défaut: false.
ENABLE_DAILY_BRIEFING=false
# Expression cron à 5 ou 6 champs. Optionnelle, défaut: 0 8 * * *.
DAILY_BRIEFING_TIME=0 8 * * *
# Réponse automatique WhatsApp. Optionnelle, défaut: false (mode économique).
ENABLE_AUTO_RESPONSE=false
# Calendar. Optionnelle, défaut: false.
ENABLE_CALENDAR_INTEGRATION=false

# --- Webhook de déploiement (scripts/webhook-server.js uniquement) ---
# Port du webhook. Optionnelle, défaut: 9000.
WEBHOOK_PORT=9000
# Secret HMAC du webhook. Obligatoire pour activer un webhook sécurisé.
WEBHOOK_SECRET=
# Répertoire de déploiement. Optionnelle, défaut défini par le script.
DEPLOY_DIR=
